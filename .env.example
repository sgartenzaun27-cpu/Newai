# Nur für lokales Testen: Datei nach ".env" kopieren und Keys eintragen.
# Auf Vercel trägst du diese Werte unter Settings → Environment Variables ein.
# Einer reicht – sind mehrere da, springt der nächste ein, wenn einer voll ist.

GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Optional (Standardwerte):
# GEMINI_MODEL=gemini-3.5-flash-lite
# OPENROUTER_MODEL=openrouter/free
# GROQ_MODEL=openai/gpt-oss-120b
# AI_REIHENFOLGE=gemini,openrouter,groq,eigener
# AI_MAX_TOKENS=3000
# AI_REASONING_EFFORT=low
# DAILY_LIMIT=20

# Alte Einstellung, funktioniert weiter (wird als letzter Anbieter genutzt):
# AI_API_KEY=
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=google/gemini-3.5-flash-lite
